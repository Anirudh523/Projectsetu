rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "officer"];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isPairedWith(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return signedIn()
        && exists(userPath)
        && get(userPath).data.pairId is string
        && exists(/databases/$(database)/documents/pairs/$(get(userPath).data.pairId))
        && get(/databases/$(database)/documents/pairs/$(get(userPath).data.pairId)).data.members.hasAny([uid])
        && get(/databases/$(database)/documents/pairs/$(get(userPath).data.pairId)).data.members.hasAny([request.auth.uid]);
    }

    function isActivePairMember(pairId) {
      let pairPath = /databases/$(database)/documents/pairs/$(pairId);
      return signedIn()
        && exists(pairPath)
        && get(pairPath).data.status == "active"
        && get(pairPath).data.members is list
        && get(pairPath).data.members.size() == 2
        && get(pairPath).data.members.hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff() || isPairedWith(uid));
      allow write: if false;
    }

    match /identities/{uid} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /letters/{letterId} {
      allow read: if resource.data.pairId is string
        && isActivePairMember(resource.data.pairId)
        && (resource.data.status == "approved" || resource.data.authorUid == request.auth.uid);
      allow write: if false;
    }

    match /drafts/{draftId} {
      allow read: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.pairId is string
        && draftId == request.resource.data.pairId + "_" + request.auth.uid;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.pairId is string
        && draftId == request.resource.data.pairId + "_" + request.auth.uid;
      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && resource.data.pairId is string
        && draftId == resource.data.pairId + "_" + request.auth.uid;
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
