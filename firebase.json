{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": [{
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", "src", "*.log", "tsconfig.json", "build.mjs"]
  }],
  "hosting": {
    "public": "placeholder",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
